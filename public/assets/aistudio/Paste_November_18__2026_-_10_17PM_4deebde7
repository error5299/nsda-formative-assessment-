                dInst.innerHTML = '<div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>';
            }
        }

        function shuffleArray(arr) {
            const copy = [...arr];
            for (let i = copy.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [copy[i], copy[j]] = [copy[j], copy[i]];
            }
            return copy;
        }

        function startAssessment() {
            const rawName = document.getElementById('candidateNameInput').value.trim();
            sessionConfig.candidateName = rawName || "Candidate";
            sessionConfig.scope = document.getElementById('scopeSelector').value;
            sessionConfig.shuffle = document.getElementById('shuffleToggle').checked;

            let selectedPool = [];
            if (sessionConfig.scope === 'all') {
                selectedPool = [...MCQ_BANK, ...MATCHING_BANK, ...SHORT_BANK];
            } else if (sessionConfig.scope === 'set1') {
                selectedPool = [
                    ...MCQ_BANK.filter(i => i.set === 'set1'),
                    ...MATCHING_BANK.filter(i => i.set === 'set1'),
                    ...SHORT_BANK.filter(i => i.set === 'set1')
                ];
            } else if (sessionConfig.scope === 'set2') {
                selectedPool = [
                    ...MCQ_BANK.filter(i => i.set === 'set2'),
                    ...MATCHING_BANK.filter(i => i.set === 'set2'),
                    ...SHORT_BANK.filter(i => i.set === 'set2')
                ];
            } else if (sessionConfig.scope === 'mcq') {
                selectedPool = [...MCQ_BANK];
            } else if (sessionConfig.scope === 'matching') {
                selectedPool = [...MATCHING_BANK];
            } else if (sessionConfig.scope === 'short') {
                selectedPool = [...SHORT_BANK];
            }

            if (sessionConfig.shuffle) {
                selectedPool = shuffleArray(selectedPool);
            }

            examData = {
                items: selectedPool,
                currentIndex: 0,
                answers: {},
                matchVerified: {},
                shortRevealed: {},
                shortGrades: {},
                flagged: {},
                timerId: null,
                secondsLeft: sessionConfig.timeMinutes * 60,
                startedAt: Date.now()
            };

            document.getElementById('setupScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('examScreen').classList.remove('hidden');
            document.getElementById('examHeaderBar').classList.remove('hidden');

            document.getElementById('headerFeedbackLabel').textContent =
                sessionConfig.feedbackMode === 'instant' ? 'Instant Feedback' : 'Real Exam Mode';

            const scopeEl = document.getElementById('scopeSelector');
            document.getElementById('scopeBadgeLabel').textContent = scopeEl.options[scopeEl.selectedIndex].text.split('(')[0].trim();

            initTimer();
            buildSectionTabs();
            renderActiveQuestion();
            renderNavigator();
            updateProgressBar();
        }

        function initTimer() {
            if (examData.timerId) clearInterval(examData.timerId);
            const timerText = document.getElementById('timerText');
            const timerContainer = document.getElementById('timerContainer');

            if (sessionConfig.timeMinutes === 0) {
                timerText.textContent = "∞ Unlimited";
                timerContainer.className = "bg-nsda-charcoalDark border border-slate-600 px-3 py-1.5 rounded-xl flex items-center space-x-2";
                return;
            }

            refreshTimerDisplay();
            examData.timerId = setInterval(() => {
                examData.secondsLeft--;
                refreshTimerDisplay();
                if (examData.secondsLeft <= 0) {
                    clearInterval(examData.timerId);
                    notifyToast("⏰ Time expired! Automatically submitting your assessment...");
                    submitAssessment();
                }
            }, 1000);
        }

        function refreshTimerDisplay() {
            const m = Math.floor(examData.secondsLeft / 60);
            const s = examData.secondsLeft % 60;
            const timerText = document.getElementById('timerText');
            const timerContainer = document.getElementById('timerContainer');

            timerText.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
            if (examData.secondsLeft <= 300) {
                timerContainer.className = "bg-rose-950 border border-rose-500 px-3 py-1.5 rounded-xl flex items-center space-x-2 animate-pulse";
                timerText.classList.add('text-rose-300');
            } else {
                timerContainer.className = "bg-nsda-charcoalDark border border-slate-600 px-3 py-1.5 rounded-xl flex items-center space-x-2";
                timerText.classList.remove('text-rose-300');
            }
        }

        // =========================================================================
        // QUESTION RENDERING & INTERACTION
        // =========================================================================
        function buildSectionTabs() {
            const container = document.getElementById('sectionTabsContainer');
            container.innerHTML = '';

            const types = [
                { key: 'mcq', label: `Part A: MCQs (${examData.items.filter(x => x.type === 'mcq').length})` },
                { key: 'matching', label: `Part B: Matching (${examData.items.filter(x => x.type === 'matching').length} Sets)` },
                { key: 'short', label: `Part C: Short Answer (${examData.items.filter(x => x.type === 'short').length})` }
            ];

            types.forEach(t => {
                const idx = examData.items.findIndex(x => x.type === t.key);
                if (idx !== -1) {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.dataset.qtype = t.key;
                    btn.textContent = t.label;
                    btn.onclick = () => goToQuestion(idx);
                    btn.className = "sec-pill px-3.5 py-1.5 rounded-xl text-xs font-bold border transition";
                    container.appendChild(btn);
                }
            });
        }

        function highlightActiveTab(type) {
            document.querySelectorAll('.sec-pill').forEach(btn => {
                if (btn.dataset.qtype === type) {
                    btn.className = "sec-pill px-3.5 py-1.5 rounded-xl text-xs font-bold border border-nsda-cyan bg-nsda-cyanLight text-nsda-charcoalDark transition";
                } else {
                    btn.className = "sec-pill px-3.5 py-1.5 rounded-xl text-xs font-bold border border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 transition";
                }
            });
        }

        function renderActiveQuestion() {
            const item = examData.items[examData.currentIndex];
            const total = examData.items.length;
            const card = document.getElementById('questionCard');

            highlightActiveTab(item.type);

            document.getElementById('btnPrev').disabled = examData.currentIndex === 0;
            document.getElementById('btnNext').textContent = examData.currentIndex === total - 1 ? "Finish & Submit →" : "Next →";
            document.getElementById('btnFlagLabel').textContent = examData.flagged[item.id] ? "Marked (Unmark)" : "Mark for Review";

            let typeBadge = '';
            if (item.type === 'mcq') typeBadge = '<span class="px-2.5 py-1 rounded-lg bg-sky-100 text-sky-800 text-xs font-bold">Part A • MCQ</span>';
            if (item.type === 'matching') typeBadge = '<span class="px-2.5 py-1 rounded-lg bg-purple-100 text-purple-800 text-xs font-bold">Part B • Matching Set (5 Pairs)</span>';
            if (item.type === 'short') typeBadge = '<span class="px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 text-xs font-bold">Part C • Short Answer / Task Analysis</span>';

            let html = `
                <div>
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-5 pb-3 border-b border-slate-100">
                        <div class="flex items-center space-x-2">
                            <span class="text-sm font-extrabold text-nsda-charcoal">Item ${examData.currentIndex + 1} of ${total}</span>
                            ${typeBadge}
                        </div>
                        <span class="text-xs font-bold uppercase text-slate-400">${item.set === 'set1' ? 'Mock Set-01' : 'Mega Set-02'}</span>
                    </div>
            `;

            // --- PART A: MCQ ---
            if (item.type === 'mcq') {
                const chosen = examData.answers[item.id];
                const showInstant = sessionConfig.feedbackMode === 'instant' && chosen !== undefined;
                const letters = ['A', 'B', 'C', 'D'];

                html += `<h3 class="text-lg sm:text-xl font-bold text-slate-900 leading-snug mb-6 whitespace-pre-line">${item.question}</h3>`;
                html += `<div class="space-y-3">`;

                item.options.forEach((opt, idx) => {
                    let btnStyle = "border-slate-200 hover:border-nsda-cyan bg-white text-slate-800";
                    let badgeStyle = "bg-slate-100 text-slate-700 border-slate-300";
                    let rightTag = "";

                    if (showInstant) {
                        if (idx === item.answer) {
                            btnStyle = "border-emerald-500 bg-emerald-50 text-emerald-950 font-semibold";
                            badgeStyle = "bg-emerald-500 text-white border-emerald-500";
                            rightTag = '<span class="text-emerald-700 font-bold text-xs ml-auto shrink-0">✓ Correct Answer</span>';
                        } else if (idx === chosen && idx !== item.answer) {
                            btnStyle = "border-rose-500 bg-rose-50 text-rose-950 font-semibold";
                            badgeStyle = "bg-rose-500 text-white border-rose-500";
                            rightTag = '<span class="text-rose-700 font-bold text-xs ml-auto shrink-0">✕ Your Selection</span>';
                        } else {
                            btnStyle = "border-slate-200 bg-slate-50/60 text-slate-400";
                        }
                    } else if (chosen === idx) {
                        btnStyle = "border-nsda-cyan bg-nsda-cyanLight text-nsda-charcoalDark font-semibold";
                        badgeStyle = "bg-nsda-cyan text-nsda-charcoalDark border-nsda-cyan";
                    }

                    html += `
                        <button type="button" onclick="selectMcqOption('${item.id}', ${idx})"
                            class="w-full text-left p-4 rounded-xl border-2 transition flex items-center space-x-3.5 ${btnStyle}">
                            <span class="w-8 h-8 rounded-lg border flex items-center justify-center font-bold text-sm shrink-0 ${badgeStyle}">
                                ${letters[idx]}
                            </span>
                            <span class="text-sm sm:text-base">${opt}</span>
                            ${rightTag}
                        </button>
                    `;
                });

                html += `</div>`;

                if (showInstant) {
                    const isRight = chosen === item.answer;
                    html += `
                        <div class="mt-6 p-4 rounded-xl border ${isRight ? 'bg-emerald-50/80 border-emerald-300 text-emerald-950' : 'bg-rose-50/80 border-rose-300 text-rose-950'}">
                            <p class="font-bold text-sm mb-1">
                                ${isRight ? '✓ Correct! Well done.' : `✕ Incorrect. The correct option is ${letters[item.answer]}.`}
                            </p>
                            <p class="text-sm leading-relaxed text-slate-800">${item.explanation}</p>
                        </div>
                    `;
                }
            }

            // --- PART B: MATCHING SET ---
            if (item.type === 'matching') {
                const userMap = examData.answers[item.id] || {};
                const verified = sessionConfig.feedbackMode === 'instant' && examData.matchVerified[item.id];

                html += `
                    <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-1.5">${item.title}</h3>
                    <p class="text-xs sm:text-sm text-slate-500 mb-4">Match each item in Column A with the correct option (A–F) from Column B.</p>

                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 mb-5">
                        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Column B Options Reference:</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs sm:text-sm">
                            ${item.options.map(o => `<div><span class="font-bold text-nsda-charcoal">${o.key})</span> ${o.text}</div>`).join('')}
