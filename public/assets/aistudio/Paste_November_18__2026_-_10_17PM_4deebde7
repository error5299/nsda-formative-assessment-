        }

        function handleCustomMinutes(val) {
            const parsed = parseInt(val, 10);
            if (!isNaN(parsed) && parsed > 0) {
                sessionConfig.timeMinutes = parsed;
                document.querySelectorAll('.time-preset-btn').forEach(b => {
                    b.classList.remove('border-nsda-cyan', 'bg-nsda-cyanLight', 'text-nsda-charcoalDark', 'font-bold');
                    b.classList.add('border-slate-200', 'text-slate-700', 'font-semibold');
                });
            }
        }

        function setFeedbackMode(mode) {
            sessionConfig.feedbackMode = mode;
            const cInst = document.getElementById('cardInstantMode');
            const cExam = document.getElementById('cardExamMode');
            const dInst = document.getElementById('dotInstant');
            const dExam = document.getElementById('dotExam');

            if (mode === 'instant') {
                cInst.className = "cursor-pointer p-4 rounded-2xl border-2 border-nsda-cyan bg-nsda-cyanLight/70 transition flex items-start space-x-3.5";
                dInst.className = "w-5 h-5 rounded-full border-2 border-nsda-cyan flex items-center justify-center bg-white";
                dInst.innerHTML = '<div class="w-2.5 h-2.5 rounded-full bg-nsda-cyan"></div>';

                cExam.className = "cursor-pointer p-4 rounded-2xl border-2 border-slate-200 hover:border-slate-300 bg-white transition flex items-start space-x-3.5";
                dExam.className = "w-5 h-5 rounded-full border-2 border-slate-400 flex items-center justify-center bg-white";
                dExam.innerHTML = '<div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>';
            } else {
                cExam.className = "cursor-pointer p-4 rounded-2xl border-2 border-nsda-cyan bg-nsda-cyanLight/70 transition flex items-start space-x-3.5";
                dExam.className = "w-5 h-5 rounded-full border-2 border-nsda-cyan flex items-center justify-center bg-white";
                dExam.innerHTML = '<div class="w-2.5 h-2.5 rounded-full bg-nsda-cyan"></div>';

