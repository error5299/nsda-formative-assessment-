        // =========================================================================
        // PRE-EXAM CONFIGURATION HANDLERS
        // =========================================================================
        function handleTimePreset(mins, btn) {
            sessionConfig.timeMinutes = mins;
            document.getElementById('customMinutesInput').value = '';
            document.querySelectorAll('.time-preset-btn').forEach(b => {
                b.classList.remove('border-nsda-cyan', 'bg-nsda-cyanLight', 'text-nsda-charcoalDark', 'font-bold');
