<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NSDA CBT&A Level-4 Assessment & Quiz Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        nsda: {
                            cyan: '#00B8E6',
                            cyanDark: '#0092B8',
                            cyanLight: '#E6F8FD',
                            charcoal: '#3B4652',
                            charcoalDark: '#232A32',
                            surface: '#F4F7F9'
                        }
                    },
                    fontFamily: {
                        sans: ['"Google Sans"', '"Hind Siliguri"', 'sans-serif'],
                        bengali: ['"Hind Siliguri"', '"Google Sans"', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Google Sans', 'Hind Siliguri', sans-serif;
            background-color: #F4F7F9;
            color: #1E293B;
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #E2E8F0; }
        ::-webkit-scrollbar-thumb { background: #94A3B8; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #64748B; }
        @media print {
            .no-print { display: none !important; }
            body { background-color: #FFFFFF !important; }
            .print-card { box-shadow: none !important; border: 1px solid #CBD5E1 !important; break-inside: avoid; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-nsda-cyan selection:text-nsda-charcoalDark">

    <!-- Sticky Top Header -->
    <header class="bg-nsda-charcoal text-white shadow-md sticky top-0 z-40 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-nsda-cyan flex items-center justify-center font-bold text-nsda-charcoalDark text-sm tracking-tight shadow-inner shrink-0">
                    NSDA
                </div>
                <div>
                    <h1 class="text-sm sm:text-lg font-bold tracking-tight leading-tight">CBT&A Level-4 Assessment Portal</h1>
                    <p class="text-[11px] sm:text-xs text-slate-300 font-bengali">জাতীয় দক্ষতা উন্নয়ন কর্তৃপক্ষ • মেগা অনুশীলন ও মূল্যায়ন প্ল্যাটফর্ম</p>
                </div>
            </div>

            <!-- Live Exam Controls (Visible during test) -->
            <div id="examHeaderBar" class="hidden flex items-center space-x-2 sm:space-x-4">
                <div class="hidden md:flex flex-col text-right">
                    <span class="text-[10px] uppercase tracking-wider text-slate-300">Feedback Mode</span>
                    <span id="headerFeedbackLabel" class="text-xs font-semibold text-nsda-cyan">Instant Feedback</span>
                </div>

                <div id="timerContainer" class="bg-nsda-charcoalDark border border-slate-600 px-3 py-1.5 rounded-xl flex items-center space-x-2">
                    <svg class="w-4 h-4 text-nsda-cyan shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span id="timerText" class="font-mono font-bold text-xs sm:text-sm text-white">60:00</span>
                </div>

                <button type="button" onclick="toggleDrawerMobile()" class="lg:hidden bg-slate-700 hover:bg-slate-600 text-white px-2.5 py-2 rounded-xl text-xs font-semibold">
                    Grid
                </button>

                <button type="button" onclick="openSubmitModal()" class="bg-nsda-cyan hover:bg-nsda-cyanDark text-nsda-charcoalDark font-bold text-xs sm:text-sm px-3.5 py-2 rounded-xl transition shadow">
                    Submit Exam
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ==================== 1. PRE-EXAM CONFIGURATION SCREEN ==================== -->
        <section id="setupScreen" class="max-w-4xl mx-auto">
            <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
                <!-- Banner -->
                <div class="bg-gradient-to-r from-nsda-charcoal to-nsda-charcoalDark p-6 sm:p-8 text-white">
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                        <span class="px-3 py-1 rounded-full bg-nsda-cyan/20 text-nsda-cyan text-xs font-bold tracking-wide uppercase">
                            Full Mega Question Bank • 135 Items
                        </span>
                        <span class="px-3 py-1 rounded-full bg-white/10 text-slate-200 text-xs font-medium">
                            60 MCQs • 7 Matching Sets (35 Pairs) • 40 Short Answers
                        </span>
                    </div>
                    <h2 class="text-2xl sm:text-3xl font-bold mb-2">Assessment Configuration & Setup</h2>
                    <p class="text-slate-300 text-sm sm:text-base font-bengali">
                        পরীক্ষা শুরু করার আগে পরীক্ষার্থীর নাম, প্রশ্ন সেট, সময়সীমা এবং প্রতি প্রশ্নের পর উত্তর দেখার মোড নির্বাচন করুন।
                    </p>
                </div>

                <div class="p-6 sm:p-8 space-y-6">
                    <!-- Row 1: Candidate Name & Question Scope -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="candidateNameInput" class="block text-sm font-bold text-slate-700 mb-2">
                                Candidate Name (পরীক্ষার্থীর নাম)
                            </label>
                            <input type="text" id="candidateNameInput" value="Belayet" placeholder="Enter candidate name"
                                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-nsda-cyan focus:border-nsda-cyan outline-none transition text-slate-800 font-medium">
                        </div>

                        <div>
                            <label for="scopeSelector" class="block text-sm font-bold text-slate-700 mb-2">
                                Question Scope / Set Filter (প্রশ্ন সেট নির্বাচন)
                            </label>
                            <select id="scopeSelector"
                                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-nsda-cyan focus:border-nsda-cyan outline-none transition text-slate-800 font-medium bg-white">
                                <option value="all">All Questions (Full Mega Bank - 135 Items)</option>
                                <option value="set1">Mock Test Set-01 Only (55 Items: 20 MCQ + 3 Match + 20 Short)</option>
                                <option value="set2">Mega Practice Set-02 Only (80 Items: 40 MCQ + 4 Match + 20 Short)</option>
                                <option value="mcq">Part A: MCQs Only (60 Questions)</option>
                                <option value="matching">Part B: Matching Only (7 Sets / 35 Items)</option>
                                <option value="short">Part C: Short Answer & PC-to-Skill Only (40 Questions)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Shuffle Option -->
                    <div class="flex items-center justify-between bg-slate-50 border border-slate-200 rounded-xl px-4 py-3">
                        <div>
                            <span class="text-sm font-bold text-slate-800">Shuffle Questions Order (প্রশ্ন এলোমেলো করুন)</span>
                            <p class="text-xs text-slate-500 font-bengali">প্রতিবার অনুশীলনের সময় প্রশ্নের ক্রম পরিবর্তন করতে এটি চালু করুন।</p>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="shuffleToggle" class="sr-only peer">
                            <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-nsda-cyan"></div>
                        </label>
                    </div>

                    <!-- Row 2: Custom Time Limit Selector -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            Time Limit (সময়সীমা নির্বাচন করুন)
                        </label>
                        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5" id="timePresetGrid">
                            <button type="button" data-mins="0" onclick="handleTimePreset(0, this)"
                                class="time-preset-btn py-2.5 px-3 rounded-xl border-2 border-slate-200 text-xs sm:text-sm font-semibold text-slate-700 hover:border-nsda-cyan transition text-center">
                                No Time Limit<br><span class="text-[11px] font-normal text-slate-500">সময়সীমাহীন</span>
                            </button>
                            <button type="button" data-mins="15" onclick="handleTimePreset(15, this)"
                                class="time-preset-btn py-2.5 px-3 rounded-xl border-2 border-slate-200 text-xs sm:text-sm font-semibold text-slate-700 hover:border-nsda-cyan transition text-center">
                                15 Minutes<br><span class="text-[11px] font-normal text-slate-500">দ্রুত কুইজ</span>
                            </button>
                            <button type="button" data-mins="30" onclick="handleTimePreset(30, this)"
                                class="time-preset-btn py-2.5 px-3 rounded-xl border-2 border-slate-200 text-xs sm:text-sm font-semibold text-slate-700 hover:border-nsda-cyan transition text-center">
                                30 Minutes<br><span class="text-[11px] font-normal text-slate-500">মাঝারি টেস্ট</span>
                            </button>
                            <button type="button" data-mins="60" onclick="handleTimePreset(60, this)"
                                class="time-preset-btn py-2.5 px-3 rounded-xl border-2 border-nsda-cyan bg-nsda-cyanLight text-nsda-charcoalDark text-xs sm:text-sm font-bold transition text-center">
                                60 Minutes<br><span class="text-[11px] font-medium text-nsda-cyanDark">NSDA Standard</span>
                            </button>
                            <button type="button" data-mins="90" onclick="handleTimePreset(90, this)"
                                class="time-preset-btn py-2.5 px-3 rounded-xl border-2 border-slate-200 text-xs sm:text-sm font-semibold text-slate-700 hover:border-nsda-cyan transition text-center">
                                90 Minutes<br><span class="text-[11px] font-normal text-slate-500">ফুল ব্যাংক</span>
                            </button>
                            <div class="rounded-xl border-2 border-slate-200 px-2.5 py-1.5 flex flex-col justify-center bg-white focus-within:border-nsda-cyan">
                                <label for="customMinutesInput" class="text-[10px] font-bold uppercase text-slate-500">Custom Mins</label>
                                <input type="number" id="customMinutesInput" min="1" max="300" placeholder="e.g. 45"
                                    oninput="handleCustomMinutes(this.value)"
                                    class="w-full text-sm font-bold text-slate-800 outline-none bg-transparent">
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Answer Feedback Mode Toggle (Prominently Placed) -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">
                            Answer & Feedback Mode (প্রতি প্রশ্নের পর উত্তর দেখবেন কি না তা নির্বাচন করুন)
                        </label>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Instant Feedback Mode -->
                            <div id="cardInstantMode" onclick="setFeedbackMode('instant')"
                                class="cursor-pointer p-4 rounded-2xl border-2 border-nsda-cyan bg-nsda-cyanLight/70 transition flex items-start space-x-3.5">
                                <div class="mt-1 shrink-0">
                                    <div id="dotInstant" class="w-5 h-5 rounded-full border-2 border-nsda-cyan flex items-center justify-center bg-white">
                                        <div class="w-2.5 h-2.5 rounded-full bg-nsda-cyan"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-center flex-wrap gap-2">
                                        <span class="font-bold text-slate-900 text-base">Instant Feedback Mode</span>
                                        <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-nsda-cyan text-nsda-charcoalDark">প্রতি প্রশ্নে উত্তর</span>
                                    </div>
                                    <p class="text-xs sm:text-sm text-slate-700 font-bengali mt-1 leading-relaxed">
                                        প্রতিটি প্রশ্ন উত্তর করার সাথে সাথেই সঠিক উত্তর ও ব্যাখ্যা (এবং Short Answer-এর মডেল উত্তর) দেখতে পাবেন।
                                    </p>
                                </div>
                            </div>

                            <!-- Real Exam Mode -->
                            <div id="cardExamMode" onclick="setFeedbackMode('exam')"
                                class="cursor-pointer p-4 rounded-2xl border-2 border-slate-200 hover:border-slate-300 bg-white transition flex items-start space-x-3.5">
                                <div class="mt-1 shrink-0">
                                    <div id="dotExam" class="w-5 h-5 rounded-full border-2 border-slate-400 flex items-center justify-center bg-white">
                                        <div class="w-2.5 h-2.5 rounded-full bg-transparent"></div>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-center flex-wrap gap-2">
                                        <span class="font-bold text-slate-900 text-base">Real Exam Mode</span>
                                        <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-200 text-slate-700">পরীক্ষা শেষে উত্তর</span>
                                    </div>
                                    <p class="text-xs sm:text-sm text-slate-600 font-bengali mt-1 leading-relaxed">
                                        পরীক্ষা চলাকালীন সব উত্তর গোপন থাকবে; পরীক্ষা সাবমিট করার পর একসাথে ফলাফল ও সমাধান দেখতে পাবেন।
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Start Action -->
                    <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="text-xs sm:text-sm text-slate-600 space-y-1">
                            <p>• <strong>NSDA Passing Standard:</strong> <span class="text-emerald-700 font-bold">80% or above = Competent (C)</span> | Below 80% = Not Yet Competent (NYC).</p>
                            <p>• <strong>Keyboard Shortcuts:</strong> Press <kbd class="px-1.5 py-0.5 bg-white border rounded text-xs font-mono">A/B/C/D</kbd> or <kbd class="px-1.5 py-0.5 bg-white border rounded text-xs font-mono">1-4</kbd> for MCQs, <kbd class="px-1.5 py-0.5 bg-white border rounded text-xs font-mono">← / →</kbd> to navigate.</p>
                        </div>
                        <button type="button" onclick="startAssessment()"
                            class="w-full sm:w-auto bg-nsda-cyan hover:bg-nsda-cyanDark text-nsda-charcoalDark font-extrabold text-base px-8 py-3.5 rounded-xl shadow-md hover:shadow-lg transition transform active:scale-95 whitespace-nowrap">
                            Start Assessment →
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== 2. ACTIVE ASSESSMENT INTERFACE ==================== -->
        <section id="examScreen" class="hidden">
            <!-- Section Jump Tabs & Progress Bar -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 mb-6">
                <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                    <div class="flex flex-wrap gap-2" id="sectionTabsContainer"></div>
                    <div class="text-xs sm:text-sm font-bold text-slate-700">
                        Progress: <span id="progressStatsText" class="text-nsda-cyanDark">0 / 0</span>
                    </div>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2.5 overflow-hidden">
                    <div id="progressBar" class="bg-nsda-cyan h-2.5 rounded-full transition-all duration-300" style="width: 0%"></div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <!-- Question Workspace (8 columns) -->
                <div class="lg:col-span-8 space-y-4">
                    <div id="questionCard" class="bg-white rounded-2xl shadow-md border border-slate-200 p-5 sm:p-7 min-h-[400px] flex flex-col justify-between">
                        <!-- Rendered dynamically -->
                    </div>

                    <!-- Bottom Navigation Bar -->
                    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 flex items-center justify-between gap-2">
                        <button type="button" id="btnPrev" onclick="moveQuestion(-1)"
                            class="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-bold text-xs sm:text-sm hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition">
                            ← Previous
                        </button>

                        <button type="button" id="btnFlag" onclick="toggleFlag()"
                            class="px-4 py-2.5 rounded-xl border border-amber-300 bg-amber-50 text-amber-800 font-bold text-xs sm:text-sm hover:bg-amber-100 transition flex items-center space-x-1.5">
                            <span>⚑</span>
                            <span id="btnFlagLabel">Mark for Review</span>
                        </button>

                        <button type="button" id="btnNext" onclick="moveQuestion(1)"
                            class="px-5 py-2.5 rounded-xl bg-nsda-charcoal hover:bg-nsda-charcoalDark text-white font-bold text-xs sm:text-sm transition">
                            Next →
                        </button>
                    </div>
                </div>

                <!-- Right Question Navigator Drawer / Panel (4 columns) -->
                <aside id="navigatorDrawer" class="hidden lg:block lg:col-span-4 bg-white rounded-2xl shadow-md border border-slate-200 p-5 sticky top-20">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="font-bold text-slate-800 text-xs uppercase tracking-wider">Question Navigator</h3>
                        <span id="scopeBadgeLabel" class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">Full Bank</span>
                    </div>

                    <!-- Status Legend -->
                    <div class="grid grid-cols-2 gap-2 text-xs text-slate-600 mb-4 pb-3 border-b border-slate-100">
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-nsda-cyan inline-block"></span><span>Current</span></div>
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-emerald-500 inline-block"></span><span>Answered</span></div>
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-amber-400 inline-block"></span><span>Marked Review</span></div>
                        <div class="flex items-center space-x-1.5"><span class="w-3 h-3 rounded bg-slate-200 inline-block"></span><span>Unanswered</span></div>
                    </div>

                    <!-- Number Grid -->
                    <div id="navigatorGrid" class="grid grid-cols-6 sm:grid-cols-8 lg:grid-cols-6 gap-2 max-h-[380px] overflow-y-auto pr-1"></div>

                    <div class="mt-5 pt-4 border-t border-slate-200">
                        <button type="button" onclick="openSubmitModal()"
                            class="w-full py-3 rounded-xl bg-nsda-cyan hover:bg-nsda-cyanDark text-nsda-charcoalDark font-extrabold text-sm shadow transition">
                            Finish & Submit Assessment
                        </button>
                    </div>
                </aside>
            </div>
        </section>

        <!-- ==================== 3. NSDA CARS RESULT DASHBOARD ==================== -->
        <section id="resultScreen" class="hidden space-y-6">
            <!-- Summary Card -->
            <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden print-card">
                <div class="bg-nsda-charcoal text-white p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div>
                        <p class="text-xs uppercase tracking-widest text-nsda-cyan font-bold mb-1">Competency Assessment Result Summary (CARS)</p>
                        <h2 id="carsCandidateName" class="text-2xl sm:text-3xl font-extrabold">Belayet</h2>
                        <p id="carsMetaInfo" class="text-sm text-slate-300 mt-1">Qualification: CBT&A Methodology Level-4 • Time Taken: 0m 0s</p>
                    </div>

                    <div id="carsDecisionBox" class="px-6 py-4 rounded-2xl text-center border-2">
                        <span class="block text-[11px] uppercase tracking-wider font-bold opacity-85">Official NSDA Decision</span>
                        <span id="carsDecisionText" class="text-xl sm:text-2xl font-extrabold">COMPETENT (C)</span>
                    </div>
                </div>

                <!-- Breakdown Metrics -->
                <div class="grid grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 lg:divide-x divide-slate-200 bg-slate-50">
                    <div class="p-5 text-center">
                        <span class="text-xs font-bold uppercase text-slate-500">Overall Score</span>
                        <p id="carsOverallScore" class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">0 / 0</p>
                        <p id="carsOverallPercent" class="text-sm font-bold text-nsda-cyanDark mt-0.5">0%</p>
                    </div>
                    <div class="p-5 text-center">
                        <span class="text-xs font-bold uppercase text-slate-500">Part A: MCQ Score</span>
                        <p id="carsMcqScore" class="text-2xl font-extrabold text-slate-800 mt-1">0 / 0</p>
                        <p class="text-xs text-slate-500 mt-0.5">Auto-graded</p>
                    </div>
                    <div class="p-5 text-center">
                        <span class="text-xs font-bold uppercase text-slate-500">Part B: Matching Score</span>
                        <p id="carsMatchScore" class="text-2xl font-extrabold text-slate-800 mt-1">0 / 0</p>
                        <p class="text-xs text-slate-500 mt-0.5">Pair-by-pair graded</p>
                    </div>
                    <div class="p-5 text-center">
                        <span class="text-xs font-bold uppercase text-slate-500">Part C: Short Answer</span>
                        <p id="carsShortScore" class="text-2xl font-extrabold text-slate-800 mt-1">0 / 0</p>
                        <p class="text-xs text-slate-500 mt-0.5">Self-assessed C / NYC</p>
                    </div>
                </div>

                <!-- Review Filter & Print Controls -->
                <div class="p-4 sm:px-8 bg-white border-t border-slate-200 flex flex-wrap items-center justify-between gap-3 no-print">
                    <div class="flex flex-wrap gap-2">
