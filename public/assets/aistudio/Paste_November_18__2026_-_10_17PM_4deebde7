                    </div>

                    <div class="space-y-3">
                `;

                item.pairs.forEach((pair, pIdx) => {
                    const val = userMap[pIdx] || "";
                    let rowStyle = "border-slate-200 bg-white";
                    let statusLine = "";

                    if (verified) {
                        if (val === pair.answer) {
                            rowStyle = "border-emerald-400 bg-emerald-50/70";
                            statusLine = `<span class="text-xs font-bold text-emerald-700 block mt-1">✓ Correct Match (${pair.answer})</span>`;
                        } else {
                            const rightObj = item.options.find(o => o.key === pair.answer);
                            rowStyle = "border-rose-400 bg-rose-50/70";
                            statusLine = `<span class="text-xs font-bold text-rose-700 block mt-1">✕ Correct Match: ${pair.answer}) ${rightObj ? rightObj.text : ''}</span>`;
                        }
                    }

                    html += `
                        <div class="p-3.5 rounded-xl border ${rowStyle} flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                            <div class="text-sm text-slate-800 font-medium flex-1">
                                <span class="font-bold text-slate-500 mr-1.5">${pIdx + 1}.</span>${pair.prompt}
                                ${statusLine}
                            </div>
                            <select onchange="selectMatchingPair('${item.id}', ${pIdx}, this.value)"
                                class="sm:w-64 px-3 py-2 rounded-lg border border-slate-300 bg-white text-sm font-semibold text-slate-800 focus:ring-2 focus:ring-nsda-cyan outline-none">
                                <option value="">-- Select Match --</option>
                                ${item.options.map(o => `<option value="${o.key}" ${val === o.key ? 'selected' : ''}>${o.key}) ${o.text}</option>`).join('')}
                            </select>
                        </div>
                    `;
                });

                html += `</div>`;

                if (sessionConfig.feedbackMode === 'instant') {
                    html += `
                        <div class="mt-5 flex justify-end">
                            <button type="button" onclick="checkMatchingSet('${item.id}')"
                                class="px-4 py-2 rounded-xl bg-nsda-cyan hover:bg-nsda-cyanDark text-nsda-charcoalDark font-bold text-xs sm:text-sm shadow-sm transition">
                                Check Matching Set Answers
                            </button>
                        </div>
                    `;
                }
            }

            // --- PART C: SHORT ANSWER & PC-TO-SKILL ---
            if (item.type === 'short') {
                const written = examData.answers[item.id] || "";
                const revealed = examData.shortRevealed[item.id] || false;
                const grade = examData.shortGrades[item.id] || null;

                html += `
                    <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-4">
                        <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-relaxed whitespace-pre-line">${item.question}</h3>
                    </div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-2">
                        Your Written Answer (Write in English, or Bengali with CBT&A technical terms in English):
                    </label>
                    <textarea rows="5" oninput="updateShortText('${item.id}', this.value)"
                        placeholder="Type your response here..."
                        class="w-full p-4 rounded-xl border border-slate-300 focus:ring-2 focus:ring-nsda-cyan focus:border-nsda-cyan outline-none text-sm sm:text-base text-slate-800">${written}</textarea>
                `;

                if (sessionConfig.feedbackMode === 'instant') {
                    html += `
                        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                            <button type="button" onclick="toggleModelAnswer('${item.id}')"
                                class="px-4 py-2.5 rounded-xl bg-nsda-charcoal hover:bg-nsda-charcoalDark text-white font-bold text-xs sm:text-sm transition">
                                ${revealed ? 'Hide Model Answer' : '👁 Reveal Model Answer & Key Points'}
                            </button>
                            ${grade ? `<span class="text-xs font-bold px-3 py-1 rounded-full ${grade === 'C' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">Self-Grade: ${grade === 'C' ? 'Competent (1 Mark)' : 'Not Yet Competent (0 Marks)'}</span>` : ''}
                        </div>
                    `;

                    if (revealed) {
                        html += `
                            <div class="mt-4 p-4 rounded-xl bg-emerald-50/80 border border-emerald-300">
                                <p class="text-xs font-extrabold uppercase tracking-wider text-emerald-800 mb-1.5">Model Answer & Key Points:</p>
                                <p class="text-sm text-slate-800 whitespace-pre-line leading-relaxed mb-4">${item.modelAnswer}</p>
                                <div class="pt-3 border-t border-emerald-200 flex flex-wrap items-center justify-between gap-2">
