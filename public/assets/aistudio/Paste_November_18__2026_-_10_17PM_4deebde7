                                    <div class="flex space-x-2">
                                        <button type="button" onclick="setShortGrade('${item.id}', 'C')"
                                            class="px-3.5 py-1.5 rounded-lg text-xs font-bold border transition ${grade === 'C' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-white text-emerald-700 border-emerald-400 hover:bg-emerald-50'}">
                                            ✓ Competent (C)
                                        </button>
                                        <button type="button" onclick="setShortGrade('${item.id}', 'NYC')"
                                            class="px-3.5 py-1.5 rounded-lg text-xs font-bold border transition ${grade === 'NYC' ? 'bg-amber-600 text-white border-amber-600' : 'bg-white text-amber-800 border-amber-400 hover:bg-amber-50'}">
                                            ! Not Yet Competent (NYC)
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                } else {
                    html += `
                        <p class="text-xs text-slate-500 mt-2 italic">
                            Real Exam Mode active: Model answers and self-assessment grading will unlock right after you submit the exam.
                        </p>
                    `;
                }
            }

            html += `</div>`;
            card.innerHTML = html;
        }

        // =========================================================================
        // USER INPUT HANDLERS
        // =========================================================================
        function selectMcqOption(id, optionIndex) {
            if (sessionConfig.feedbackMode === 'instant' && examData.answers[id] !== undefined) {
                return; // Lock first attempt in instant feedback mode
            }
            examData.answers[id] = optionIndex;
            renderActiveQuestion();
            renderNavigator();
            updateProgressBar();
        }

        function selectMatchingPair(id, pairIdx, key) {
            if (!examData.answers[id]) examData.answers[id] = {};
            if (key === "") {
                delete examData.answers[id][pairIdx];
            } else {
                examData.answers[id][pairIdx] = key;
            }
            renderNavigator();
            updateProgressBar();
        }

        function checkMatchingSet(id) {
            examData.matchVerified[id] = true;
            renderActiveQuestion();
        }

        function updateShortText(id, text) {
            examData.answers[id] = text;
            renderNavigator();
            updateProgressBar();
        }

        function toggleModelAnswer(id) {
            examData.shortRevealed[id] = !examData.shortRevealed[id];
            renderActiveQuestion();
        }

        function setShortGrade(id, status) {
            examData.shortGrades[id] = status;
            renderActiveQuestion();
            renderNavigator();
            updateProgressBar();
        }

        // =========================================================================
        // NAVIGATION & DRAWER
        // =========================================================================
        function moveQuestion(delta) {
            const target = examData.currentIndex + delta;
            if (target >= examData.items.length) {
                openSubmitModal();
                return;
            }
            if (target >= 0) {
                examData.currentIndex = target;
                renderActiveQuestion();
                renderNavigator();
            }
        }

        function goToQuestion(idx) {
            examData.currentIndex = idx;
            renderActiveQuestion();
            renderNavigator();
        }

        function toggleFlag() {
            const item = examData.items[examData.currentIndex];
            if (examData.flagged[item.id]) delete examData.flagged[item.id];
            else examData.flagged[item.id] = true;
            renderActiveQuestion();
            renderNavigator();
        }

        function toggleDrawerMobile() {
            const drawer = document.getElementById('navigatorDrawer');
            drawer.classList.toggle('hidden');
        }

        function isItemAnswered(item) {
            const ans = examData.answers[item.id];
            if (item.type === 'mcq') return ans !== undefined;
            if (item.type === 'matching') return ans && Object.keys(ans).length > 0;
            if (item.type === 'short') return (ans && ans.trim().length > 0) || examData.shortGrades[item.id] !== undefined;
            return false;
        }

        function renderNavigator() {
            const grid = document.getElementById('navigatorGrid');
            grid.innerHTML = '';

            examData.items.forEach((item, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = idx + 1;
                btn.onclick = () => goToQuestion(idx);

                let cls = "h-9 rounded-lg text-xs font-bold border transition ";
                if (idx === examData.currentIndex) {
                    cls += "bg-nsda-cyan text-nsda-charcoalDark border-nsda-charcoal ring-2 ring-nsda-cyan/50";
                } else if (examData.flagged[item.id]) {
                    cls += "bg-amber-400 text-amber-950 border-amber-500";
                } else if (isItemAnswered(item)) {
                    cls += "bg-emerald-500 text-white border-emerald-600";
                } else {
                    cls += "bg-slate-100 text-slate-600 border-slate-200 hover:bg-slate-200";
                }

                btn.className = cls;
                grid.appendChild(btn);
            });
        }

        function updateProgressBar() {
            const total = examData.items.length;
            const done = examData.items.filter(isItemAnswered).length;
            const pct = total > 0 ? Math.round((done / total) * 100) : 0;

            document.getElementById('progressStatsText').textContent = `${done} / ${total} (${pct}%)`;
            document.getElementById('progressBar').style.width = `${pct}%`;
        }

        // Keyboard Shortcuts
        document.addEventListener('keydown', (e) => {
            if (document.getElementById('examScreen').classList.contains('hidden')) return;
            if (['TEXTAREA', 'INPUT', 'SELECT'].includes(document.activeElement.tagName)) return;

            const item = examData.items[examData.currentIndex];
            if (item && item.type === 'mcq') {
                const k = e.key.toUpperCase();
                if (k === 'A' || k === '1') selectMcqOption(item.id, 0);
                if (k === 'B' || k === '2') selectMcqOption(item.id, 1);
                if (k === 'C' || k === '3') selectMcqOption(item.id, 2);
                if (k === 'D' || k === '4') selectMcqOption(item.id, 3);
            }
            if (e.key === 'ArrowRight') moveQuestion(1);
            if (e.key === 'ArrowLeft') moveQuestion(-1);
        });

        // =========================================================================
        // SUBMISSION & NSDA CARS DASHBOARD
        // =========================================================================
        function openSubmitModal() {
            const total = examData.items.length;
            const done = examData.items.filter(isItemAnswered).length;
            document.getElementById('submitModalText').textContent =
                `You have completed ${done} of ${total} items. Once submitted, your official NSDA Competency Assessment Result Summary (CARS) and all model answers will be displayed.`;
            document.getElementById('submitModal').classList.remove('hidden');
        }

        function closeSubmitModal() {
            document.getElementById('submitModal').classList.add('hidden');
        }

        function submitAssessment() {
            closeSubmitModal();
            if (examData.timerId) clearInterval(examData.timerId);

            const elapsedSecs = Math.max(1, Math.floor((Date.now() - examData.startedAt) / 1000));
            const mins = Math.floor(elapsedSecs / 60);
            const secs = elapsedSecs % 60;

            let mcqGot = 0, mcqMax = 0;
            let matchGot = 0, matchMax = 0;
            let shortGot = 0, shortMax = 0;

            examData.items.forEach(item => {
                if (item.type === 'mcq') {
                    mcqMax++;
                    if (examData.answers[item.id] === item.answer) mcqGot++;
                } else if (item.type === 'matching') {
                    const userMap = examData.answers[item.id] || {};
                    item.pairs.forEach((p, idx) => {
                        matchMax++;
                        if (userMap[idx] === p.answer) matchGot++;
                    });
                } else if (item.type === 'short') {
                    shortMax++;
                    if (examData.shortGrades[item.id] === 'C') shortGot++;
                }
            });

            const totalGot = mcqGot + matchGot + shortGot;
            const totalMax = mcqMax + matchMax + shortMax;
            const percent = totalMax > 0 ? Math.round((totalGot / totalMax) * 100) : 0;
            const isCompetent = percent >= 80;

            document.getElementById('carsCandidateName').textContent = sessionConfig.candidateName;
            document.getElementById('carsMetaInfo').textContent =
                `Qualification: CBT&A Methodology Level-4 • Mode: ${sessionConfig.feedbackMode === 'instant' ? 'Instant Feedback' : 'Real Exam'} • Time Taken: ${mins}m ${secs}s`;

            const box = document.getElementById('carsDecisionBox');
            const text = document.getElementById('carsDecisionText');
            if (isCompetent) {
                box.className = "px-6 py-4 rounded-2xl text-center border-2 border-emerald-400 bg-emerald-500/20 text-emerald-300";
                text.textContent = "COMPETENT (C)";
            } else {
                box.className = "px-6 py-4 rounded-2xl text-center border-2 border-amber-400 bg-amber-500/20 text-amber-300";
                text.textContent = "NOT YET COMPETENT (NYC)";
            }

            document.getElementById('carsOverallScore').textContent = `${totalGot} / ${totalMax}`;
            document.getElementById('carsOverallPercent').textContent = `${percent}% (NSDA Benchmark: 80%)`;
            document.getElementById('carsMcqScore').textContent = `${mcqGot} / ${mcqMax}`;
            document.getElementById('carsMatchScore').textContent = `${matchGot} / ${matchMax}`;
            document.getElementById('carsShortScore').textContent = `${shortGot} / ${shortMax}`;

            document.getElementById('examScreen').classList.add('hidden');
            document.getElementById('examHeaderBar').classList.add('hidden');
            document.getElementById('resultScreen').classList.remove('hidden');

            renderReviewCards('all');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function applyReviewFilter(filter, btn) {
            document.querySelectorAll('.rev-filter-btn').forEach(b => {
                b.className = "rev-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200";
            });
            btn.className = "rev-filter-btn px-3.5 py-2 rounded-xl text-xs font-bold bg-nsda-charcoal text-white";
            renderReviewCards(filter);
        }

        function renderReviewCards(filter) {
            const container = document.getElementById('reviewContainer');
            container.innerHTML = '';
            const letters = ['A', 'B', 'C', 'D'];

            examData.items.forEach((item, idx) => {
                let outcome = 'incorrect'; // 'correct' | 'incorrect'

                if (item.type === 'mcq') {
                    outcome = examData.answers[item.id] === item.answer ? 'correct' : 'incorrect';
                } else if (item.type === 'matching') {
                    const userMap = examData.answers[item.id] || {};
                    const allMatched = item.pairs.every((p, i) => userMap[i] === p.answer);
                    outcome = allMatched ? 'correct' : 'incorrect';
                } else if (item.type === 'short') {
                    outcome = examData.shortGrades[item.id] === 'C' ? 'correct' : 'incorrect';
                }

                if (filter === 'correct' && outcome !== 'correct') return;
                if (filter === 'incorrect' && outcome !== 'incorrect') return;

                const borderCol = outcome === 'correct' ? 'border-emerald-300' : 'border-rose-300';
                const statusBadge = outcome === 'correct'
                    ? '<span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">✓ Competent / Correct</span>'
                    : '<span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800 text-xs font-bold">✕ Review / NYC</span>';

                let contentHtml = '';

                if (item.type === 'mcq') {
                    const userVal = examData.answers[item.id];
                    contentHtml = `
                        <p class="font-bold text-slate-900 text-base mb-3">${item.question}</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm mb-3">
                            ${item.options.map((opt, i) => {
                                let style = "p-2.5 rounded-lg border ";
                                if (i === item.answer) style += "bg-emerald-50 border-emerald-400 text-emerald-950 font-bold";
                                else if (i === userVal) style += "bg-rose-50 border-rose-400 text-rose-950 font-semibold";
                                else style += "bg-slate-50 border-slate-200 text-slate-600";
                                return `<div class="${style}">${letters[i]}) ${opt}</div>`;
                            }).join('')}
                        </div>
                        <p class="text-xs sm:text-sm text-slate-700 bg-sky-50/70 border border-sky-200 p-3 rounded-xl">
                            <strong>Explanation:</strong> ${item.explanation}
                        </p>
                    `;
                } else if (item.type === 'matching') {
                    const userMap = examData.answers[item.id] || {};
                    contentHtml = `
                        <p class="font-bold text-slate-900 text-base mb-3">${item.title}</p>
                        <div class="space-y-2 text-sm">
                            ${item.pairs.map((p, i) => {
                                const uKey = userMap[i];
                                const ok = uKey === p.answer;
                                const rightOpt = item.options.find(o => o.key === p.answer);
                                const userOpt = item.options.find(o => o.key === uKey);
                                return `
                                    <div class="p-2.5 rounded-lg border ${ok ? 'bg-emerald-50/60 border-emerald-300' : 'bg-rose-50/60 border-rose-300'} flex flex-col sm:flex-row sm:justify-between gap-1">
                                        <span class="text-slate-800 font-medium">${i + 1}. ${p.prompt}</span>
                                        <span class="text-xs font-bold ${ok ? 'text-emerald-800' : 'text-rose-800'}">
                                            ${ok ? `✓ ${p.answer}) ${rightOpt.text}` : `Your: ${uKey ? uKey + ') ' + userOpt.text : 'Unanswered'} | Correct: ${p.answer}) ${rightOpt.text}`}
                                        </span>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                    `;
                } else if (item.type === 'short') {
                    const userText = examData.answers[item.id] || "(No written response entered)";
                    const grade = examData.shortGrades[item.id];
                    contentHtml = `
                        <p class="font-bold text-slate-900 text-base mb-3 whitespace-pre-line">${item.question}</p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
                                <span class="block text-xs font-bold uppercase text-slate-500 mb-1">Your Written Answer:</span>
                                <p class="text-slate-800 whitespace-pre-line">${userText}</p>
                            </div>
                            <div class="p-3.5 rounded-xl bg-emerald-50/80 border border-emerald-300">
                                <span class="block text-xs font-bold uppercase text-emerald-800 mb-1">Model Answer & Key Points:</span>
                                <p class="text-slate-800 whitespace-pre-line">${item.modelAnswer}</p>
                            </div>
                        </div>
                        <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between flex-wrap gap-2 no-print">
                            <span class="text-xs text-slate-600 font-bold">Self-Assessment Marking (updates CARS score):</span>
                            <div class="flex space-x-2">
                                <button type="button" onclick="regradeShort('${item.id}', 'C')"
                                    class="px-3 py-1.5 rounded-lg text-xs font-bold border transition ${grade === 'C' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-white text-emerald-700 border-emerald-300 hover:bg-emerald-50'}">
                                    ✓ Competent (1 Mark)
                                </button>
                                <button type="button" onclick="regradeShort('${item.id}', 'NYC')"
                                    class="px-3 py-1.5 rounded-lg text-xs font-bold border transition ${grade === 'NYC' ? 'bg-amber-600 text-white border-amber-600' : 'bg-white text-amber-800 border-amber-300 hover:bg-amber-50'}">
                                    ! Not Yet Competent (0 Marks)
                                </button>
                            </div>
                        </div>
                    `;
                }

                const card = document.createElement('div');
                card.className = `bg-white rounded-2xl shadow-sm border ${borderCol} p-5 print-card`;
                card.innerHTML = `
                    <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-100">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-500">
                            Item #${idx + 1} • ${item.type.toUpperCase()} (${item.set === 'set1' ? 'Set-01' : 'Set-02'})
                        </span>
                        ${statusBadge}
                    </div>
                    ${contentHtml}
                `;
                container.appendChild(card);
            });
        }

        function regradeShort(id, status) {
            examData.shortGrades[id] = status;
            submitAssessment();
        }

        function returnToSetup() {
            if (examData.timerId) clearInterval(examData.timerId);
            document.getElementById('resultScreen').classList.add('hidden');
            document.getElementById('examScreen').classList.add('hidden');
            document.getElementById('examHeaderBar').classList.add('hidden');
            document.getElementById('setupScreen').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function notifyToast(message) {
            const box = document.getElementById('toastBox');
            box.textContent = message;
            box.classList.remove('hidden');
            setTimeout(() => box.classList.add('hidden'), 4000);
        }
    </script>
</body>
</html>